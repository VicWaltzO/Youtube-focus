{
  "manifest_version": 3,
  "name": "YouTube Focus",
  "version": "0.1.0",
  "description": "Prototipo de detección de tarjetas de YouTube. El filtrado todavía no está disponible.",
  "action": {
    "default_title": "YouTube Focus",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
